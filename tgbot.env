# Telegram Bot 环境变量配置（V2 增强版）
# 复制到 /etc/tgbot/tgbot.env 后填写真实值

# 从 @BotFather 获取
BOT_TOKEN=8619608394:AAGIXKoqvwE0xiM8M9JxboLMv1QlnHYWRrM

# 从 https://my.telegram.org/apps 获取
API_ID=34759349
API_HASH=39c9342d83cbf7a0721e81c89451dd3e

# 会话文件目录
# 如果修改到 /var/lib/tgbot 之外，请同步修改 tgbot.service 中的 ReadWritePaths
SESSION_DIR=/var/lib/tgbot/sessions

# 临时文件根目录
# 默认放在 /tmp/tgbot，便于任务结束后自动清理
TEMP_DIR_BASE=/tmp/tgbot

# 单个文件大小上限（MB）
# 默认 1024，更适合小磁盘 LXC；如果磁盘足够，可改为 2048
MAX_FILE_SIZE_MB=1024

# 最大并发任务数
# 小规格 LXC 建议保持 1
MAX_CONCURRENT_JOBS=1

# 下载任务时，至少保留的剩余磁盘空间（MB）
MIN_FREE_SPACE_MB=256

# 相册 / 媒体组搜索窗口
# 收到某条链接后，会向前向后搜索附近消息，找出同一 grouped_id
MEDIA_GROUP_WINDOW=12

# 自动清理策略
# 临时文件保留时长（分钟）
TEMP_RETENTION_MINUTES=180

# 后台自动清理扫描周期（分钟）
CLEANUP_INTERVAL_MINUTES=30

# 错误状态消息自动删除时间（秒）
# 设为 0 表示保留错误消息，不自动删除
AUTO_DELETE_ERROR_SEC=120

# 是否启用 ffmpeg 视频抽帧封面
ENABLE_FFMPEG_THUMB=1
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_SEC=20

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
